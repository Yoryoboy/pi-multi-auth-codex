  "description": "Pi extension for multi-account Codex OAuth rotation and failover",
  "type": "module",
  "license": "MIT",
  "author": "Yoryoboy",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yoryoboy/pi-multi-auth-codex.git"
  },
